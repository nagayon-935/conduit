# Conduit 本番環境変数テンプレート
# このファイルを .env.prod にコピーして実際の値を設定してください
# cp .env.prod.example .env.prod

# Vault サーバーのアドレス
VAULT_ADDR=http://x.x.x.x:8200

# Vault アクセストークン
VAULT_TOKEN=hvs.xxxxxxxxxxxxxxxxxxxxxxxx

# Vault SSH Secrets Engine の設定（変更不要）
VAULT_SSH_ROLE=conduit
VAULT_SSH_MOUNT=ssh

# Conduit バックエンドのリッスンポート（変更不要）
SERVER_PORT=8080

# セッション設定（必要に応じて調整）
GRACE_PERIOD=15m
SESSION_GC_INTERVAL=1m

# Web の同一オリジン（実際の公開ホスト名に置き換える）
PUBLIC_URL=https://conduit.example.com
# 接続先・踏み台のアドレス範囲を限定する
SSH_ALLOWED_CIDRS=192.168.1.0/24
# DB・録画を永続ボリュームに保存
DB_PATH=/app/data/conduit.db
RECORDING_DIR=/app/recordings
KNOWN_HOSTS_PATH=/app/config/known_hosts
# 初期の録画設定（管理画面から変更可能）
RECORDING_ENABLED=true
SESSION_IDLE_TIMEOUT=30m
# 必要な場合のみ、信頼した nginx の送信元を指定
# TRUSTED_PROXY_CIDRS=172.18.0.2/32
